{
  "name": "echochat-live",
  "version": "1.12.3",
  "description": "ЭхоЧат LIVE — озвучка чата TikTok LIVE живыми нейро-голосами",
  "main": "main.js",
  "author": "EchoChat",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "pages": "node tools/build-pages.js",
    "dist": "electron-builder --win portable --x64",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "msedge-tts": "^2.0.0",
    "qrcode-generator": "^1.4.4",
    "tiktok-live-connector": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "live.echochat.app",
    "productName": "EchoChat LIVE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "errors.js",
      "events.js",
      "twitch.js",
      "widget.js",
      "widget-page.js",
      "widget-donate-page.js",
      "kaspi.js",
      "tts-engines.js",
      "shortcut.js",
      "selftest.js",
      "src/**/*",
      "package.json",
      "!tools/**",
      "assets/**"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "EchoChat-LIVE-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "afterPack": "tools/adhoc-sign.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "src/icon.png",
      "identity": null,
      "artifactName": "EchoChat-LIVE-${version}-mac-arm64.${ext}"
    }
  }
}